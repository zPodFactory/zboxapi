[DEFAULT]
# Base interface name for VLAN management
interface = eth1

# MTU setting for VLAN interfaces
mtu = 1700

# System default VLANs that cannot be modified (comma-separated)
system_vlans_default = 10,20,30

# System zPod VLANs that cannot be modified (comma-separated)
system_vlans_zpod = 64,128,192

# ── VLAN masquerade (nftables). Every key is optional. ──
[masquerade]
# Where translated traffic leaves zcore (the management interface)
out_interface = eth0
# The one nftables file zboxapi writes; load it at boot through /etc/nftables.conf
nft_file = /etc/nftables.d/zboxapi-masquerade.nft
# nftables table name (family inet); it belongs to zboxapi
table = zboxapi

# ── zcore only: disks, storages and NFS exports. Every key is optional. ──
[storage]
filer_root = /FILER
# Never modified except grown; STORAGE01 is always included
protected_storages = STORAGE01
mount_unit_dir = /etc/systemd/system
filesystem = ext4
# No reserved blocks for root on a data volume. ext4's inode tables are zeroed lazily
# in the background after the first mount (the Debian default), so mkfs takes seconds.
mkfs_options = -m 0
mount_options = defaults,noatime,nofail

[nfs]
exports_file = /etc/exports.d/zboxapi.exports
system_exports_file = /etc/exports
# Never modified; NFS-01 is always included
protected_exports = /FILER/STORAGE01/NFS-01
export_options = rw,no_subtree_check,no_root_squash
folder_owner = root:root
folder_mode = 0777
